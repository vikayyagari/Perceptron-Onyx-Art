# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension required
DATABASE_URL=postgresql://perceptron:perceptron@localhost:5432/gallery?schema=public
DATABASE_URL_TEST=postgresql://perceptron:perceptron@localhost:5432/gallery_test?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Run `pnpm keys:generate` from the backend directory to generate these.
# Store as single-line strings with \n for newlines.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── S3 / Object Storage ──────────────────────────────────────────────────────
# For local dev with MinIO:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=perceptron-gallery
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Public base URL for generating image URLs (no trailing slash)
S3_PUBLIC_URL=http://localhost:9000/perceptron-gallery

# For AWS production:
# S3_ENDPOINT=          (leave blank to use default AWS endpoint)
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001

# ─── OAuth providers ──────────────────────────────────────────────────────────
# Apple Sign In (required for iOS app)
APPLE_APP_ID=com.yourcompany.perceptron-gallery

# Google Sign In (required for Android app)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Twilio (Phone OTP) ───────────────────────────────────────────────────────
# Leave blank to use stub (logs OTP to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute for general endpoints
RATE_LIMIT_MAX=100
# Requests per minute for auth endpoints (stricter)
RATE_LIMIT_AUTH_MAX=10
